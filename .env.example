# GAMBIT YourMove — environment
#
# Copy to .env.local (git-ignored) and fill in ONE of the two backends below.
# The app validates this on the first request and fails with a named error if
# neither is complete. It never falls back to fixture data because a key is
# missing.

# ---------------------------------------------------------------------------
# Option A — Gemini API (simplest; get a key at https://aistudio.google.com)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Option B — Vertex AI (use this if you deploy with a service account instead
# of an API key). Leave GEMINI_API_KEY empty when using this path.
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Fixture mode — OPT-IN ONLY
# ---------------------------------------------------------------------------
# When true, /api/read returns a stored fixture and calls no model. Every
# response is tagged mode:"mock" and the UI shows a visible badge, so a fixture
# can never be mistaken for a live read. Use it to work on the interface
# without a key, and as a rehearsed demo path if the venue network fails.
# GAMBIT_MOCK=true

# Extra per-request latency lines in the server log.
# GAMBIT_TELEMETRY_VERBOSE=true
